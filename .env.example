# Copy this file to .env and fill in your own values.
# Never commit real secrets to source control.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
DATABASE_PATH=data/cohortiq.db
UPLOAD_DIR=data/uploads
EXTRACTED_DIR=data/extracted

# --- Authentication (FastAPI backend) ---------------------------------------
# Deployment environment: development, test or production.
# In production the API refuses to start unless JWT_SECRET_KEY is set and strong.
APP_ENV=development

# Secret used to sign access tokens (HS256). Leave blank here and set your own
# value only in your local, uncommitted .env file. Requirements: at least 32
# bytes, random, not a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Token issuer and audience. Both sides of a deployment must use the same values.
JWT_ISSUER=cohortiq-ai-api
JWT_AUDIENCE=cohortiq-ai-clients

# Access-token lifetime in minutes (1-1440) and allowed clock skew in seconds (0-300).
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_LEEWAY_SECONDS=30
